# === AI Provider ===
# 둘 다 설정하면 OpenAIProvider(실제 API 호출)를 사용한다.
# 둘 중 하나라도 비어 있으면 MockAIProvider로 자동 폴백한다 (packages/ai/create-provider.mjs).
# API 키는 절대 코드에 하드코딩하지 않는다 — 이 파일도 실제 값을 채운 뒤에는 .env로 복사해서 쓰고
# .env 자체는 git에 커밋하지 않는다 (.gitignore에 이미 포함됨).
OPENAI_API_KEY=
OPENAI_MODEL=

# === 캐주얼 채팅 전용 저가 모델 (선택) ===
# 일상 잡담(§13/§14 "casual" intent) 리액션을 저가 모델로 생성하고 싶으면 설정한다.
# 비워두면 캐주얼 대화는 무료 고정 반응 목록으로만 동작한다(비용 0원) — 메인 OPENAI_MODEL을
# 실수로 재사용하지 않도록 의도적으로 별도 변수로 분리했다. 예: gpt-5-nano (1시간 캐주얼 대화 기준
# 1원 미만으로 추정 — REAL-AI-EVALUATION.md 및 CHANGELOG "13차 반영" 참고).
OPENAI_CASUAL_MODEL=

# === Server ===
PORT=3000

# === 선택 — 비용 추정용 (설정 안 하면 usage 원본 토큰 수만 저장되고 비용은 계산되지 않음) ===
# OPENAI_INPUT_PRICE_PER_1M=
# OPENAI_OUTPUT_PRICE_PER_1M=

# === STEP 3 신규 — DB (Supabase Postgres) ===
# Supabase 대시보드 → Settings → Database → Connection string에서 복사.
# 이 값이 없으면 인증/결제 관련 라우트는 명확한 에러를 반환한다(가짜로 동작하지 않음).
DATABASE_URL=

# === STEP 3 신규 — 카카오 로그인 ===
# Kakao Developers(https://developers.kakao.com) 앱의 REST API 키.
KAKAO_CLIENT_ID=
# 카카오 로그인 보안 탭에서 발급(선택 — 활성화했다면 반드시 설정).
KAKAO_CLIENT_SECRET=
# 카카오 로그인 활성화 시 등록한 Redirect URI와 정확히 일치해야 함.
# 예: http://localhost:3000/api/auth/kakao/callback
KAKAO_REDIRECT_URI=

# === STEP 4 신규 — 네이버 로그인 ===
# Naver Developers(https://developers.naver.com/apps) 앱의 Client ID/Secret.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 예: http://localhost:3000/api/auth/naver/callback
NAVER_REDIRECT_URI=

# === STEP 4 신규 — 구글 로그인 ===
# Google Cloud Console에서 발급한 OAuth 클라이언트 ID/Secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 예: http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# === STEP 3 신규 — 로그인 성공/실패 후 리다이렉트할 프론트엔드 주소 ===
FRONTEND_BASE_URL=http://localhost:5173

# === 결제 시스템 신규 — Toss Payments ===
# https://developers.tosspayments.com 에서 발급. 처음엔 반드시 테스트 키로 시작.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# === 프론트엔드용 Toss 클라이언트 키 (apps/web) ===
# apps/web/.env.local 등 Vite가 읽는 파일에 설정. secret key와 달리 공개되어도 안전.
VITE_TOSS_CLIENT_KEY=
