# apps/web/.env.example
#
# Vite는 빌드 시점에 이 변수들을 정적으로 주입한다(런타임에 바뀌지 않음).
# Vercel에 배포할 때는 Project Settings > Environment Variables에 아래 두 값을 등록한다.
#
# 백엔드(apps/api) API 서버의 공개 URL. 비워두면 개발 편의를 위해 http://localhost:3000으로
# 동작하지만(apps/web/src/config.js), 실제 배포본에서는 반드시 실제 API 서버 주소로 설정해야
# 한다 - 안 하면 production에서 API 호출이 전부 실패한다.
VITE_API_BASE_URL=

# Toss Payments 클라이언트 키(공개 키, secret key와 달리 프론트에 노출돼도 안전).
# Toss Payments 가입/심사 완료 후 발급받는 값을 넣는다. 비워두면 결제 화면에서
# "결제 기능이 아직 설정되지 않았어요" 안내만 뜨고 결제 자체는 막힌다(이번 단계에서는
# 정상 - Toss 가입 전이므로 비워둔 채로 배포해도 안전).
VITE_TOSS_CLIENT_KEY=
